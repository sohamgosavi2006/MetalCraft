# MetalCraft Local Agent Environment Configuration Example
# Copy this file to .env and fill in your actual keys for local development.
# DO NOT commit .env with real credentials to GitHub.

# Agent Backend Configuration
LOCAL_AGENT_HOST=0.0.0.0
LOCAL_AGENT_PORT=8080

# Gemini API Configuration (Google AI Studio / Vertex AI)
GEMINI_API_KEY=

# Partner MCP Integrations
# 1. Parallel (Creative Research)
PARALLEL_API_KEY=

# 2. Grafana (Observability & Telemetry)
GRAFANA_URL=http://localhost:3000
GRAFANA_TOKEN=

# Google Cloud (Future production deployment)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
