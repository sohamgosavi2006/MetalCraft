# ============================================================
# MetalCraft Production & Development Environment Variables
# ============================================================
# DO NOT COMMIT SECRETS OR KEYS TO VERSION CONTROL.
# Configure these variables in Render Dashboard for production.

ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080

# Google Gemini 2.5 Creative Director API Key (Server-Side Only)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Parallel AI Creative & Cinematography Research Key (Server-Side Only)
PARALLEL_API_KEY=your_parallel_api_key_here

# Grafana Cloud Telemetry & Observability
GRAFANA_URL=https://your-grafana-instance.grafana.net
GRAFANA_TOKEN=your_grafana_service_account_token_here

# Persistent Metadata Database (Render Disk or SQLite)
DATABASE_URL=sqlite+aiosqlite:///./metalcraft_state.db

# iOS Device Registration & HMAC Auth Secret
IOS_AUTH_SECRET=generate_a_secure_random_hex_string_here

# CORS Allowed Origins (Comma-separated for production)
CORS_ALLOWED_ORIGINS=https://metalcraft.onrender.com,http://localhost:8080
